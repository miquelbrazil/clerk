# Variable NAMES only. Never commit real values.
# Local values are injected at runtime by Infisical (see docs/decisions.md
# D-005 / D-013). This file documents what the app reads, nothing more.

# --- Application ---------------------------------------------------------
# Set to 1 to surface Slim's error details. Never enable in deployment.
APP_DEBUG=

# --- Staging database ----------------------------------------------------
# Defaults target the Lando `database` service, so local development needs
# none of these set. Deployment supplies all of them.
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# --- Zoho Books (Phase 2+) -----------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_API_DOMAIN=

# --- Backblaze B2 (Phase 2+) ---------------------------------------------
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_REGION=
B2_ENDPOINT=

# --- Local tooling -------------------------------------------------------
# Absolute host path used by spatie/ray to map container paths back to the
# editor. Personal filesystem path — never commit a value.
RAY_LOCAL_DIR=
