#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Command\EnvCheck;
use App\Command\ParseStatement;
use Symfony\Component\Console\Application;

require dirname(__DIR__) . '/vendor/autoload.php';
require dirname(__DIR__) . '/config/bootstrap.php';

$cli = new Application('clerk', '0.1.0');

// Symfony Console 8 removed Application::add() in favour of addCommand().
$cli->addCommand(new ParseStatement());
$cli->addCommand(new EnvCheck());

$cli->run();
