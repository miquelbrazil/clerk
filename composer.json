{
    "name": "miquelbrazil/clerk",
    "description": "Personal financial data engineering system: ingest, normalize, dedupe, categorize, and push clean data to Zoho Books.",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Miquel Brazil",
            "email": "miquel@brazilliance.co"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "cakephp/chronos": "^3.0",
        "cakephp/collection": "^5.0",
        "cakephp/core": "^5.0",
        "cakephp/i18n": "^5.0",
        "cakephp/orm": "^5.4",
        "hashids/hashids": "^5.0",
        "league/csv": "^9.0",
        "league/flysystem": "^3.19",
        "league/flysystem-aws-s3-v3": "^3.19",
        "league/mime-type-detection": "^1.14",
        "league/plates": "^3.6",
        "php-di/php-di": "^7.1",
        "robmorgan/phinx": "^0.16.12",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15",
        "smalot/pdfparser": "^2.12",
        "symfony/console": "^8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "pestphp/pest": "^5.1",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0",
        "spatie/ray": "^1.0"
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse",
        "cs": "phpcs",
        "cs:fix": "phpcbf"
    },
    "scripts-descriptions": {
        "test": "Run the Pest test suite.",
        "stan": "Run PHPStan static analysis (level 8).",
        "cs": "Check PSR-12 coding standards.",
        "cs:fix": "Auto-fix fixable coding-standards violations."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
